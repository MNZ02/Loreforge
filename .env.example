# Where agents check out per-task working copies
AGENT_WORKDIR=~/.agent-company/work

# Concurrent agents (capacity, not "seats" — one sub runs several in parallel)
AGENT_MAX_PARALLEL=2

# NOTE: do NOT set ANTHROPIC_API_KEY here while you want subscription billing —
# it silently overrides your Max plan's Agent SDK credit. Add it only in
# Phase 3 when a workflow outgrows the monthly credit.
