# policy.env — the company's autonomy + token policy. Sourced by all loops.

# ---- Token efficiency -------------------------------------------------------
# Model tier for Claude agent runs (sonnet = right tier for specified tasks;
# override per-run: AGENT_CLAUDE_MODEL=fable ./tick.sh for a hard ticket)
AGENT_CLAUDE_MODEL=sonnet
# Effort for headless Claude runs — written into each task dir's project
# settings so your interactive "max" default never bleeds into agent runs.
AGENT_CLAUDE_EFFORT=medium
# Codex reasoning effort for agent runs (your interactive config stays ultra)
AGENT_CODEX_EFFORT=medium
# Turn caps (hard stop on runaway loops)
AGENT_DEV_MAX_TURNS=80
AGENT_REVIEW_MAX_TURNS=40

# ---- Autonomy policy --------------------------------------------------------
# 1 = merge automatically when: reviewer verdict is LGTM*, no failing/pending
#     checks, and no sensitive paths touched. 0 = you merge everything.
AUTO_MERGE=1
# How many review→fix rounds before escalating to a human
AGENT_MAX_FIX_ROUNDS=1
# Paths that always escalate to a human, never auto-merge (extended regex)
SENSITIVE_PATHS='^\.github/|^deploy/|Dockerfile|docker-compose|\.env|migrations?/|auth|billing|payment'

# ---- Ops ----------------------------------------------------------------
AGENT_MAX_PARALLEL=2
AGENT_STALE_HOURS=3
